{
  "name": "corella",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "npm run build -w @corella/shared && npm run build -w @corella/server && npm run build -w @corella/web",
    "dev": "npm run build -w @corella/shared && node scripts/dev.mjs",
    "wt": "node scripts/wt.mjs",
    "start": "npm run build && npm start -w @corella/server",
    "typecheck": "tsc -b packages/shared packages/server && npm run typecheck -w @corella/web",
    "test": "npm run build && npm run test:unit && npm run test:server",
    "test:unit": "node --experimental-strip-types --test 'packages/web/src/__tests__/*.test.ts'",
    "test:server": "node --test --test-timeout=45000 'packages/server/test/*.test.mjs'"
  },
  "devDependencies": {
    "@types/node": "22.18.13",
    "@types/ws": "8.18.2",
    "typescript": "5.9.3"
  }
}
